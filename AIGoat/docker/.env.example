# Copy to .env before: docker compose up --build -d
# Or keep in sync with the repo-root .env
HOST_BIND=0.0.0.0
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=local
APP_SECRET_KEY=aiet-workshop-local-secret

# Ollama device mode for deploy.sh / Enable-Access.ps1:
#   auto — use GPU if nvidia-smi works, else CPU (default)
#   gpu  — require GPU overlay (docker-compose.gpu.yml)
#   cpu  — never request NVIDIA devices (safe on non-GPU hosts)
AIGOAT_GPU=auto

# DuckDNS - used by repo-root .\Enable-Access.ps1
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=
