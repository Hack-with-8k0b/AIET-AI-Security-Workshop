# Copy to .env in this docker/ directory and fill in the values. Never commit .env.
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_TIMEOUT=120

# Keep loopback for instructor-only smoke tests. For a classroom LAN, set this
# to the instructor machine's LAN IP (not 0.0.0.0) and firewall TCP/3000 to students.
HOST_BIND=127.0.0.1

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
