# Copy to .env: cp .env.example .env   (or let ./deploy.sh / .\deploy.ps1 create it)
# Then run: ./deploy.sh up   or   .\deploy.ps1 up
LLM_PROVIDER=nvidia
EMBEDDING_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
LLM_TIMEOUT=120

# 0.0.0.0 = reachable from host/LAN (VM port-forward). Use 127.0.0.1 for local-only.
HOST_BIND=0.0.0.0

# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
