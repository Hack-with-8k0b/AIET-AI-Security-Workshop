# AIET AI Security Workshop - copy to .env at the repo root and fill DuckDNS.
# Never commit .env. Enable-Access.ps1 syncs this into AIGoat/docker/.env.

# Bind address for published ports (3000 UI, 8000 API, 11434 Ollama)
HOST_BIND=0.0.0.0

# Local LLM (default). No cloud API key required.
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=local

# Workshop signing secret (override if you want; fine for local labs)
APP_SECRET_KEY=aiet-workshop-local-secret

# --- DuckDNS (required by .\Enable-Access.ps1) ---
# Create a free subdomain + token at https://www.duckdns.org
# Subdomain only (no .duckdns.org suffix).
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=

AIGOAT_GPU=auto   # recommended
# AIGOAT_GPU=gpu  # force NVIDIA overlay
# AIGOAT_GPU=cpu  # never request a GPU


